# Supabase project settings.
# Find these in your dashboard under: Settings (bottom-left gear icon) > API Keys
#
# As of late 2025, Supabase renamed and replaced the old key pair:
#   OLD NAME        NEW NAME              WHERE
#   anon key    ->  Publishable key       "Publishable keys" section (sb_publishable_...)
#   service_role -> Secret key            "Secret keys" section      (sb_secret_...)
#
# For SUPABASE_SERVICE_ROLE_KEY below, use the SECRET key (sb_secret_...)
# on newer projects, or the legacy service_role key on older projects that
# still show the old naming - either works the same way here.
# Do NOT use the Publishable/anon key - it doesn't have the access this
# backend needs (it's meant for public/client-side use, low privilege).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Server
PORT=4000

# Note: this key bypasses Row Level Security - your API layer is
# responsible for authorization checks, not Supabase RLS alone.
# This is deliberate: it keeps auth logic portable when you migrate
# off Supabase later.
